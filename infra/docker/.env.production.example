# Copy to infra/docker/.env and set real values before deploying.
# docker compose auto-loads this file from the compose file's directory.

# --- Database (use a strong password in production / managed Postgres) ---
POSTGRES_USER=oneplatform
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=oneplatform

# --- Public web ---
WEB_PORT=3000

# --- Custom domain + TLS (used by docker-compose.tls.yml / Caddy) ---
# The domain whose A record points at this host; Caddy gets a Let's Encrypt cert.
SITE_ADDRESS=ruben-star-one-platform.com

# --- Demo tenant / identity (the prototype uses a demo session cookie;
#     production replaces this with real IAM/SSO — see the readiness doc) ---
TENANT=star-demo
SYNC_DEMO_STAFF=T0026
