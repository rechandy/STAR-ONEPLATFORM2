# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Production image for the Next.js web app (frontend + BFF) using standalone
# output. The BFF runs server-side (App Router route handlers + server
# components) and calls the backend services over the compose network.
# Build from the REPO ROOT:
#   docker build -f infra/docker/Dockerfile.web -t op-web .
# ---------------------------------------------------------------------------
ARG NODE_VERSION=20-alpine

FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /repo

FROM base AS build
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=@oneplatform/web

FROM node:${NODE_VERSION} AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
# Standalone server bundle + static assets + public dir (monorepo layout).
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
