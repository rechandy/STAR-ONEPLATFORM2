{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS service",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "dist"
  }
}
