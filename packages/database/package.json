{
  "name": "@oneplatform/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical OneRoster + outcomes schema (Prisma/PostgreSQL) and demo seed for STAR OnePlatform.",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:rls": "node -e \"console.log('Apply prisma/rls.sql with: psql $DATABASE_URL -f prisma/rls.sql')\"",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
