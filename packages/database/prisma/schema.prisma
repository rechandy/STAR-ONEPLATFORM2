// ============================================================================
// STAR OnePlatform — Canonical Roster + Outcomes schema (Prisma / PostgreSQL)
// ----------------------------------------------------------------------------
// This is the dev/seed reference schema for the Unified Data Engine. It is
// modeled on the 1EdTech OneRoster standard and is MULTI-TENANT by design:
// every row carries `tenantId`, and Postgres Row-Level Security (see rls.sql)
// enforces isolation defensively.
//
// In production these modules split across service-owned databases
// (Roster Graph, Student Record & Outcomes, etc. — see docs/adr/0004). Here we
// co-locate them so a single `prisma db seed` can stand up a complete demo that
// every pillar (Links, SOLER, SOLS, Media Center) can read from.
//
// Module map:
//   [TENANCY]   Tenant, Org, AcademicSession           -> Roster Graph
//   [IDENTITY]  User, UserIdentifier, OrgMembership     -> IAM + Roster Graph
//   [ROSTER]    Course, Class, Enrollment               -> Roster Graph
//   [STUDENT]   StudentProfile                          -> Student Record
//   [IEP]       IepGoal              (Links + SOLER bridge)
//   [OUTCOMES]  GoalProgress, MetricEvent               -> Student Record (SOLER)
//   [SOLS]      Certification        (extension point, educator training)
//   [MEDIA]     MediaEngagement      (extension point, Media Center)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum OrgType {
  DISTRICT
  SCHOOL
}

/// OneRoster lifecycle status. TOBEDELETED supports soft-delete via sync.
enum EntityStatus {
  ACTIVE
  TOBEDELETED
}

/// Canonical role, used for both org membership and class enrollment.
enum RoleType {
  DISTRICT_ADMIN
  ADMINISTRATOR
  TEACHER
  SPECIALIST // related-service provider (SLP / OT / BCBA) — cross-teacher access
  AIDE
  STUDENT
  GUARDIAN
  STAR_STAFF
}

/// Related-service discipline for specialist staff and their caseload sections.
enum ServiceDiscipline {
  SPEECH_LANGUAGE // SLP   -> Communication
  OCCUPATIONAL_THERAPY // OT    -> Daily Living
  BEHAVIOR // BCBA  -> Behavior / Self-Regulation
}

enum SessionType {
  SCHOOL_YEAR
  SEMESTER
  TERM
  GRADING_PERIOD
}

/// STAR instructional domains (from the seed dataset).
enum GoalDomain {
  ACADEMIC_READINESS
  BEHAVIOR_SELF_REGULATION
  COMMUNICATION
  DAILY_LIVING
  SOCIAL_SKILLS
}

enum GoalStatus {
  ACTIVE
  MET
  DISCONTINUED
  ARCHIVED
}

/// Identifier namespaces enable cross-source identity matching (Clever, etc.).
enum IdentifierType {
  SIS_ID
  STATE_ID
  CLEVER_ID
  CLASSLINK_ID
  EMAIL
  STAR_LEGACY_ID
}

/// Which pillar produced a metric event.
enum MetricSource {
  LINKS
  SOLER
  SOLS
  MEDIA
  SYSTEM
}

enum MetricType {
  // progress
  TRIAL_SCORE
  ACCURACY_SNAPSHOT
  PROMPT_LEVEL_CHANGE
  // milestones
  OBJECTIVE_MASTERED
  MILESTONE_ACHIEVED
  // assessment
  ASSESSMENT_SCORED
  // behavior
  BEHAVIOR_INCIDENT
  BEHAVIOR_OBSERVATION
  // learning / media
  LESSON_COMPLETED
  COURSE_COMPLETED
  CERTIFICATION_EARNED
  MEDIA_VIEWED
  MEDIA_COMPLETED
}

enum CertificationStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

/// Lifecycle of a transactional-outbox row (ADR-0003).
enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// The four OnePlatform product pillars (licensable).
enum Product {
  LINKS
  SOLER
  SOLS
  MEDIA_CENTER
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

/// Lifecycle of a SOLER trial-by-trial data-collection session.
enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Lifecycle of a Links curriculum assignment (advanced by student.metric.v1).
enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  MASTERED
  ARCHIVED
}

// ----------------------------------------------------------------------------
// [TENANCY] — isolation boundary + org hierarchy
// ----------------------------------------------------------------------------

/// The tenant is the customer (district or agency). Top-level isolation unit.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgs                 Org[]
  academicSessions     AcademicSession[]
  users                User[]
  orgMemberships       OrgMembership[]
  courses              Course[]
  classes              Class[]
  enrollments          Enrollment[]
  studentProfiles      StudentProfile[]
  iepGoals             IepGoal[]
  goalProgress         GoalProgress[]
  metricEvents         MetricEvent[]
  certifications       Certification[]
  mediaEngagements     MediaEngagement[]
  curriculumObjectives CurriculumObjective[]
  outboxEvents         OutboxEvent[]
  outcomeRollups       OutcomeRollup[]
  productLicenses      ProductLicense[]
  guardianRelations    GuardianRelationship[]
  dataCollectionSessions DataCollectionSession[]
  trials               Trial[]
  lessons              Lesson[]
  curriculumAssignments CurriculumAssignment[]

  @@map("tenant")
}

/// OneRoster `org`. Self-referential: DISTRICT -> SCHOOL.
model Org {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  sourcedId        String       @map("sourced_id")
  type             OrgType
  name             String
  identifier       String? // human/SIS code for the org
  parentId         String?      @map("parent_id")
  status           EntityStatus @default(ACTIVE)
  dateLastModified DateTime     @default(now()) @updatedAt @map("date_last_modified")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent         Org?            @relation("OrgHierarchy", fields: [parentId], references: [id])
  children       Org[]           @relation("OrgHierarchy")
  orgMemberships OrgMembership[]
  courses        Course[]
  classes        Class[]

  @@unique([tenantId, sourcedId])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([parentId])
  @@map("org")
}

/// OneRoster `academicSession` (school year / term / grading period).
model AcademicSession {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  sourcedId        String       @map("sourced_id")
  title            String
  type             SessionType
  schoolYear       String       @map("school_year")
  startDate        DateTime     @map("start_date")
  endDate          DateTime     @map("end_date")
  parentId         String?      @map("parent_id")
  status           EntityStatus @default(ACTIVE)
  dateLastModified DateTime     @default(now()) @updatedAt @map("date_last_modified")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  AcademicSession?  @relation("SessionHierarchy", fields: [parentId], references: [id])
  terms   AcademicSession[] @relation("SessionHierarchy")
  classes Class[]

  @@unique([tenantId, sourcedId])
  @@index([tenantId])
  @@map("academic_session")
}

// ----------------------------------------------------------------------------
// [IDENTITY] — users, external identifiers, org membership
// ----------------------------------------------------------------------------

/// OneRoster `user`. One row per human (teacher, student, admin, aide...).
model User {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  sourcedId        String             @map("sourced_id")
  username         String
  givenName        String             @map("given_name")
  familyName       String             @map("family_name")
  email            String?
  primaryRole      RoleType           @map("primary_role")
  /// Set for SPECIALIST users (SLP/OT/BCBA); null for everyone else.
  staffDiscipline  ServiceDiscipline? @map("staff_discipline")
  enabled          Boolean            @default(true)
  status           EntityStatus       @default(ACTIVE)
  dateLastModified DateTime           @default(now()) @updatedAt @map("date_last_modified")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifiers      UserIdentifier[]
  orgMemberships   OrgMembership[]
  enrollments      Enrollment[]
  studentProfile   StudentProfile?
  authoredGoals    IepGoal[]              @relation("GoalAuthor")
  recordedMetrics  MetricEvent[]          @relation("MetricRecorder")
  certifications   Certification[]
  mediaEngagements MediaEngagement[]
  guardianLinks    GuardianRelationship[] @relation("GuardianLinks")
  studentGuardians GuardianRelationship[] @relation("StudentGuardians")

  @@unique([tenantId, sourcedId])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, primaryRole])
  @@map("app_user")
}

/// External IDs that map upstream sources (Clever/ClassLink/SIS) to one user.
/// This is the backbone of identity matching & dedup.
model UserIdentifier {
  id       String         @id @default(cuid())
  tenantId String         @map("tenant_id")
  userId   String         @map("user_id")
  type     IdentifierType
  value    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
  @@index([userId])
  @@map("user_identifier")
}

/// User <-> Org membership with a scoped role (OneRoster `user.orgs` + role).
/// Models "teacher OF this school", "admin OF this school", "student AT school".
model OrgMembership {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  role      RoleType
  isPrimary Boolean  @default(false) @map("is_primary")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, orgId, role])
  @@index([tenantId])
  @@index([orgId])
  @@index([userId])
  @@map("org_membership")
}

// ----------------------------------------------------------------------------
// [ROSTER] — courses, classes (sections), enrollments
// ----------------------------------------------------------------------------

/// OneRoster `course` (the template a class is a section of).
model Course {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  sourcedId        String       @map("sourced_id")
  title            String
  courseCode       String?      @map("course_code")
  grades           String[]
  subjectArea      String?      @map("subject_area")
  orgId            String       @map("org_id")
  status           EntityStatus @default(ACTIVE)
  dateLastModified DateTime     @default(now()) @updatedAt @map("date_last_modified")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  org        Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  classes    Class[]
  objectives CurriculumObjective[]

  @@unique([tenantId, sourcedId])
  @@index([tenantId])
  @@map("course")
}

/// OneRoster `class` — a SECTION taught at a school in a term. Many-to-many by
/// design: a teacher runs many sections, and a student is rostered into many
/// sections, both via `Enrollment`. `focusDomain` types domain-based sections.
model Class {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  sourcedId        String             @map("sourced_id")
  title            String
  classCode        String?            @map("class_code")
  classType        String?            @map("class_type")
  focusDomain      GoalDomain?        @map("focus_domain")
  /// Set for related-service caseload sections (SLP/OT/BCBA); null for academic sections.
  discipline       ServiceDiscipline? @map("discipline")
  courseId         String             @map("course_id")
  schoolId         String             @map("school_id")
  termId           String             @map("term_id")
  status           EntityStatus       @default(ACTIVE)
  dateLastModified DateTime           @default(now()) @updatedAt @map("date_last_modified")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  school       Org             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term         AcademicSession @relation(fields: [termId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  iepGoals     IepGoal[]
  metricEvents MetricEvent[]

  @@unique([tenantId, sourcedId])
  @@index([tenantId])
  @@index([schoolId])
  @@index([courseId])
  @@map("class")
}

/// OneRoster `enrollment` — the User <-> Class join with a role.
model Enrollment {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  sourcedId        String       @map("sourced_id")
  userId           String       @map("user_id")
  classId          String       @map("class_id")
  role             RoleType
  isPrimary        Boolean      @default(false) @map("is_primary")
  beginDate        DateTime?    @map("begin_date")
  endDate          DateTime?    @map("end_date")
  status           EntityStatus @default(ACTIVE)
  dateLastModified DateTime     @default(now()) @updatedAt @map("date_last_modified")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, classId, role])
  @@index([tenantId])
  @@index([classId])
  @@index([userId])
  @@map("enrollment")
}

// ----------------------------------------------------------------------------
// [STUDENT] — minimized student profile (Student Record service)
// ----------------------------------------------------------------------------

model StudentProfile {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  userId           String    @unique @map("user_id")
  grade            String
  age              Int?
  dateOfBirth      DateTime? @map("date_of_birth")
  primaryDiagnosis String    @map("primary_diagnosis")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  iepGoals IepGoal[]

  @@index([tenantId])
  @@map("student_profile")
}

// ----------------------------------------------------------------------------
// [IEP] — IEP goals bridge Links (curriculum) and SOLER (assessment)
// ----------------------------------------------------------------------------

model IepGoal {
  id                    String     @id @default(cuid())
  tenantId              String     @map("tenant_id")
  sourcedId             String     @map("sourced_id")
  studentId             String     @map("student_id")
  authoredById          String     @map("authored_by_id")
  classId               String?    @map("class_id")
  domain                GoalDomain
  description           String
  iepStartDate          DateTime   @map("iep_start_date")
  iepEndDate            DateTime   @map("iep_end_date")
  daysRemainingToReview Int?       @map("days_remaining_to_review")
  status                GoalStatus @default(ACTIVE)
  goalMet               Boolean    @default(false) @map("goal_met")
  /// Link to the Links curriculum objective this IEP goal is derived from.
  curriculumObjectiveId String?    @map("curriculum_objective_id")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student             StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authoredBy          User                 @relation("GoalAuthor", fields: [authoredById], references: [id])
  class               Class?               @relation(fields: [classId], references: [id])
  curriculumObjective CurriculumObjective? @relation(fields: [curriculumObjectiveId], references: [id])
  progress            GoalProgress?
  metricEvents        MetricEvent[]

  @@unique([tenantId, sourcedId])
  @@index([tenantId])
  @@index([studentId])
  @@index([domain])
  @@index([curriculumObjectiveId])
  @@map("iep_goal")
}

/// A Links curriculum objective (the scope-&-sequence target an IEP goal is
/// written from). Owned by the per-domain Links Course. This is the real
/// curriculum entity that IepGoal.curriculumObjective points at.
model CurriculumObjective {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  sourcedId   String       @map("sourced_id")
  domain      GoalDomain
  code        String // e.g. LINKS-COMM-001
  title       String
  description String?
  courseId    String?      @map("course_id")
  sequence    Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course?                @relation(fields: [courseId], references: [id])
  iepGoals    IepGoal[]
  lessons     Lesson[]
  assignments CurriculumAssignment[]

  @@unique([tenantId, sourcedId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([domain])
  @@map("curriculum_objective")
}

// ----------------------------------------------------------------------------
// [OUTCOMES] — current snapshot + canonical append-only event store (SOLER)
// ----------------------------------------------------------------------------

/// Latest progress-monitoring snapshot per goal (materialized for fast reads).
model GoalProgress {
  id                          String   @id @default(cuid())
  tenantId                    String   @map("tenant_id")
  goalId                      String   @unique @map("goal_id")
  totalSessions               Int      @map("total_sessions")
  weeksInProgram              Int      @map("weeks_in_program")
  sessionsPerWeek             Float    @map("sessions_per_week")
  baselinePromptLevel         Int      @map("baseline_prompt_level")
  currentPromptLevel          Int      @map("current_prompt_level")
  promptLevelChange           Int      @map("prompt_level_change")
  baselineAccuracy            Float    @map("baseline_accuracy")
  currentAccuracy             Float    @map("current_accuracy")
  accuracyTrendPerWeek        Float    @map("accuracy_trend_per_week")
  consecutiveProgressSessions Int      @map("consecutive_progress_sessions")
  goalMet                     Boolean  @map("goal_met")
  lastEvaluatedAt             DateTime @default(now()) @map("last_evaluated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal   IepGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("goal_progress")
}

/// Canonical, append-only outcome event. EVERY pillar writes metrics in this
/// one shape; the Unified Data Engine fans these out to all services and the
/// reporting lakehouse. `idempotencyKey` makes ingestion exactly-once-effect.
model MetricEvent {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  idempotencyKey String       @map("idempotency_key")
  source         MetricSource
  metricType     MetricType   @map("metric_type")
  studentId      String?      @map("student_id")
  goalId         String?      @map("goal_id")
  classId        String?      @map("class_id")
  recordedById   String?      @map("recorded_by_id")
  value          Json
  occurredAt     DateTime     @map("occurred_at")
  schemaVersion  Int          @default(1) @map("schema_version")
  createdAt      DateTime     @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal       IepGoal? @relation(fields: [goalId], references: [id])
  class      Class?   @relation(fields: [classId], references: [id])
  recordedBy User?    @relation("MetricRecorder", fields: [recordedById], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, metricType])
  @@index([occurredAt])
  @@map("metric_event")
}

// ----------------------------------------------------------------------------
// [SOLS] — educator training & certification (extension point)
// ----------------------------------------------------------------------------

model Certification {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  userId    String              @map("user_id")
  title     String
  status    CertificationStatus @default(ACTIVE)
  issuedAt  DateTime?           @map("issued_at")
  expiresAt DateTime?           @map("expires_at")
  ceuHours  Float?              @map("ceu_hours")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("certification")
}

// ----------------------------------------------------------------------------
// [MEDIA] — Media Center engagement (extension point)
// ----------------------------------------------------------------------------

model MediaEngagement {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  userId       String     @map("user_id")
  mediaAssetId String     @map("media_asset_id")
  metricType   MetricType @map("metric_type")
  occurredAt   DateTime   @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("media_engagement")
}

// ----------------------------------------------------------------------------
// [EVENT BACKBONE] — transactional outbox + a sample read-model projection
// ----------------------------------------------------------------------------

/// Transactional outbox (ADR-0003). A row is written in the SAME transaction as
/// the domain change; a relay publishes PENDING rows to the broker and marks
/// them PUBLISHED. No dual-write — DB commit and event are atomic.
model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  type          String // e.g. "student.metric.v1"
  payload       Json
  occurredAt    DateTime     @map("occurred_at")
  schemaVersion Int          @default(1) @map("schema_version")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("outbox_event")
}

/// A Reporting-style read model (CQRS, ADR-0004) maintained by a consumer of
/// `student.metric.v1`. Demonstrates events propagating into a projection; in
/// production this is owned by the Reporting service.
model OutcomeRollup {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  studentId      String    @map("student_id")
  totalMetrics   Int       @default(0) @map("total_metrics")
  lastMetricType String?   @map("last_metric_type")
  lastOccurredAt DateTime? @map("last_occurred_at")
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@map("outcome_rollup")
}

// ----------------------------------------------------------------------------
// [LICENSING & GUARDIANS] — product entitlements + parent/guardian links
// ----------------------------------------------------------------------------

/// A tenant's entitlement to a product pillar. The dashboard filters the four
/// pillars by the tenant's ACTIVE (non-expired) licenses.
model ProductLicense {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  product   Product
  status    LicenseStatus @default(ACTIVE)
  seats     Int?
  startsAt  DateTime?     @map("starts_at")
  expiresAt DateTime?     @map("expires_at")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, product])
  @@index([tenantId])
  @@map("product_license")
}

/// Links a guardian/parent User to a student User. A guardian may have several
/// students; a student may have several guardians.
model GuardianRelationship {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  guardianId String   @map("guardian_id")
  studentId  String   @map("student_id")
  relation   String?
  createdAt  DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardian User   @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User   @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, guardianId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([guardianId])
  @@map("guardian_relationship")
}

// ----------------------------------------------------------------------------
// [SOLER] — assessment & trial-by-trial data collection (Assessment service)
// ----------------------------------------------------------------------------
// SOLER owns these tables. Per ADR-0004 (db-per-service) they carry NO
// cross-aggregate foreign keys — student/goal/class/staff are referenced by id
// only (like `MetricEvent.studentId`), because in production these live in
// SOLER's own database fed by roster events, not alongside the roster graph.
// Only `tenant` is related, for dev-DB cascade + RLS consistency.

/// A teacher-run data-collection session against an IEP goal. Trials are logged
/// (often offline on iPad) under the session; on finalize SOLER computes
/// accuracy and emits `student.metric.v1` so Student Record + Reporting update.
model DataCollectionSession {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  /// User.id of the student (no FK — cross-aggregate; see header).
  studentId     String        @map("student_id")
  /// IepGoal.id this session collects data for (no FK — cross-aggregate).
  goalId        String?       @map("goal_id")
  /// Class.id the session was run in (no FK — cross-aggregate).
  classId       String?       @map("class_id")
  /// User.id of the staff member running the session (no FK — cross-aggregate).
  recordedById  String        @map("recorded_by_id")
  domain        GoalDomain
  status        SessionStatus @default(IN_PROGRESS)
  /// Prompt level in effect for the session (lower = more independent).
  promptLevel   Int?          @map("prompt_level")
  note          String?
  /// Mastery threshold (accuracy in [0,1]) that marks the objective mastered.
  masteryTarget Float?        @map("mastery_target")
  totalTrials   Int           @default(0) @map("total_trials")
  correctTrials Int           @default(0) @map("correct_trials")
  accuracy      Float?
  goalMastered  Boolean       @default(false) @map("goal_mastered")
  /// Canonical MetricEvent.id emitted when the session was finalized.
  metricEventId String?       @map("metric_event_id")
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trials Trial[]

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, goalId])
  @@index([status])
  @@map("data_collection_session")
}

/// A single discrete-trial datapoint within a session. `idempotencyKey` is the
/// client opId from the offline outbox, making trial sync exactly-once-effect.
model Trial {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  sessionId      String   @map("session_id")
  idempotencyKey String   @map("idempotency_key")
  ordinal        Int
  correct        Boolean
  promptLevel    Int?     @map("prompt_level")
  note           String?
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session DataCollectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([sessionId])
  @@map("trial")
}

// ----------------------------------------------------------------------------
// [LINKS] — curriculum delivery: lessons + assignments (Curriculum service)
// ----------------------------------------------------------------------------
// Links owns Lesson + CurriculumAssignment. Lessons belong to a
// CurriculumObjective (the scope-&-sequence target). Per ADR-0004 the
// assignment *targets* (class/student) are referenced by id only — no
// cross-aggregate FKs — since in production Links runs on its own DB fed by
// roster events. Assignment progress is advanced by consuming `student.metric.v1`.

/// A Links lesson delivering a curriculum objective — the scope-&-sequence leaf
/// the teacher actually teaches. `steps` holds the ordered routine + materials.
model Lesson {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  objectiveId      String       @map("objective_id")
  code             String
  title            String
  sequence         Int          @default(0)
  /// Ordered instructional steps + materials (the teaching routine), as JSON.
  steps            Json
  estimatedMinutes Int?         @map("estimated_minutes")
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective   CurriculumObjective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  assignments CurriculumAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([objectiveId])
  @@map("lesson")
}

/// Assignment of a curriculum objective (optionally a specific lesson) to a
/// class OR an individual student. Links' own read model; `status`/`lastAccuracy`
/// are advanced by the metric consumer when SOLER outcomes arrive.
model CurriculumAssignment {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  objectiveId  String           @map("objective_id")
  lessonId     String?          @map("lesson_id")
  /// Class.id when assigned to a section (no FK — cross-aggregate).
  classId      String?          @map("class_id")
  /// User.id when assigned to one student (no FK — cross-aggregate).
  studentId    String?          @map("student_id")
  /// User.id of the staff member who made the assignment.
  assignedById String           @map("assigned_by_id")
  status       AssignmentStatus @default(ASSIGNED)
  lastAccuracy Float?           @map("last_accuracy")
  masteredAt   DateTime?        @map("mastered_at")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective CurriculumObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  lesson    Lesson?             @relation(fields: [lessonId], references: [id])

  @@unique([tenantId, objectiveId, classId, studentId])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, classId])
  @@index([objectiveId])
  @@map("curriculum_assignment")
}
