SERVICE_NAME=links
NODE_ENV=development
PORT=3004
DATABASE_URL="postgresql://oneplatform:oneplatform@localhost:5432/oneplatform?schema=public"

# Event backbone (ADR-0003). Default is an in-process broker.
# Links is a CONSUMER of student.metric.v1 (it adapts instruction). With the
# in-memory broker it only sees events emitted in THIS process; use Kafka to
# consume metrics produced by SOLER / Student Record in other processes.
EVENT_BROKER=memory
# EVENT_BROKER=kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=links
# KAFKA_GROUP_ID=links
# KAFKA_TOPIC_PREFIX=
RELAY_POLL_MS=500
