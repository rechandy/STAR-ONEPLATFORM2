SERVICE_NAME=soler
NODE_ENV=development
PORT=3003
DATABASE_URL="postgresql://oneplatform:oneplatform@localhost:5433/oneplatform?schema=public"

# Event backbone (ADR-0003). Default is an in-process broker.
EVENT_BROKER=memory
# To use Kafka (start infra/kafka/docker-compose.yml first):
# EVENT_BROKER=kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=soler
# KAFKA_GROUP_ID=soler
# KAFKA_TOPIC_PREFIX=
RELAY_POLL_MS=500
